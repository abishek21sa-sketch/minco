MINCO_PROJECT_ROOT=.
MINCO_DATA_DIR=./data
MINCO_RESULTS_DIR=./results
MINCO_CONFIG_DIR=./configs
MINCO_AUDIT_DB_PATH=./results/ops_platform/audit.db

# Optional deployment-boundary control. When set, operational API routes
# require X-API-Key or Authorization: Bearer; /health and /readiness remain
# available to platform probes. Legacy single-key mode maps to admin unless
# MINCO_API_KEY_ROLE is set.
# Use a deployment secret manager and rotate this value outside the repository.
MINCO_API_KEY=
MINCO_API_KEY_ROLE=admin
MINCO_API_KEY_SUBJECT=legacy-api-key-operator

# Preferred multi-identity deployment mode. JSON maps each secret to redacted
# identity metadata; never commit real credentials.
# MINCO_API_KEYS={"reviewer-secret":{"subject":"operations-reviewer","role":"reviewer"}}

# Anthropic Claude is optional and never required for deterministic mathematics.
# Never commit a real key.
ANTHROPIC_API_KEY=
MINCO_CLAUDE_ROUTING_MODE=balanced
MINCO_CLAUDE_HAIKU_MODEL=
MINCO_CLAUDE_SONNET_MODEL=
MINCO_CLAUDE_SONNET_DAILY_TOKEN_BUDGET=250000
MINCO_CLAUDE_HAIKU_MAX_OUTPUT_TOKENS=900
MINCO_CLAUDE_SONNET_MAX_OUTPUT_TOKENS=2200

# Phase-2 native runtime
MINCO_EVENT_STORE=duckdb
MINCO_REPLAY_PROFILE=enterprise
MINCO_REPLAY_MIN_EVENTS=100000
MINCO_REPLAY_HOSPITALS=120
MINCO_OPERATING_MODE=normal
MINCO_PUBLIC_REFERENCE_CSV=data/public_reference/cms_hospital_general_information.csv
MINCO_GRPC_HOST=127.0.0.1
MINCO_GRPC_PORT=50551
# Solver posture. The default is academic research/development mode and must
# remain synthetic/replay-only unless the installed license terms change.
MINCO_SOLVER_LICENSE_MODE=academic
