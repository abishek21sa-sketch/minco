{
  "version": "0.6.0a1",
  "evidence_mode": "synthetic_reference_benchmark",
  "demand_regimes": ["NORMAL", "PRESSURE", "SURGE"],
  "mmpp": {
    "observation_unit": "hour",
    "em_tolerance": 0.0001,
    "maximum_states": 4
  },
  "ctmc": {
    "time_unit": "hour",
    "states": ["ED", "Ward", "ICU", "Stepdown", "Discharged", "Transferred"]
  },
  "monte_carlo": {
    "quick_scenarios": 500,
    "analysis_scenarios": 5000,
    "research_scenarios": 50000,
    "common_random_numbers": true
  },
  "stochastic_optimization": {
    "primary_runtime": "Julia/JuMP/Gurobi",
    "independent_oracle": "Python/SciPy/HiGHS",
    "risk_measure": "CVaR",
    "default_cvar_alpha": 0.95,
    "decomposition": "Progressive Hedging",
    "reoptimization": "rolling horizon"
  }
}
